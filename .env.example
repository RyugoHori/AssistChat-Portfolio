# AssistChat 環境変数設定例

# ==========================================
# OpenAI API（AI モード / 対話機能）
# ==========================================
# OpenAI APIキーを設定してください
# 取得方法: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-api-key-here

# ==========================================
# PostgreSQL 接続
# ==========================================
# Docker Compose を使用する場合は変更不要
DB_HOST=postgres
DB_PORT=5432
DB_NAME=assistchat
DB_USER=postgres
DB_PASSWORD=postgres
