[run]
source =
    packages/rag-core/rag_core
    services/rag-api/src
    tools/data_cleansing
branch = True
omit =
    */tests/*
    */__init__.py
    */conftest.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    \.\.\.
precision = 1
show_missing = True
skip_covered = False
